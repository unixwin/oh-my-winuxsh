# example-source plugin
# Winuxsh sources this file in the current interactive shell.
# Use WINUXSH_PLUGIN_HOOK to distinguish startup/precmd/preexec/chpwd.

example_source_hello() {
  echo "hello from a sourced Winuxsh plugin"
}

case "$WINUXSH_PLUGIN_HOOK" in
  startup)
    alias example-source-hello='example_source_hello'
    ;;
  precmd)
    export EXAMPLE_SOURCE_LAST_EXIT="$WINUXSH_LAST_EXIT_CODE"
    ;;
  preexec)
    export EXAMPLE_SOURCE_LAST_COMMAND="$WINUXSH_PREEXEC_COMMAND"
    ;;
  chpwd)
    export EXAMPLE_SOURCE_LAST_DIR="$WINUXSH_PWD"
    ;;
esac
