# Oh My Winuxsh framework entry point.
#
# Source this file from an interactive Winuxsh rc file after setting WINUXSH to
# this repository or installed bundle root:
#
#   WINUXSH=C:/Users/me/.winuxsh/oh-my-winuxsh
#   WINUXSH_PLUGINS=(prompt-core git docker zoxide)
#   WINUXSH_THEME=minimal
#   source "$WINUXSH/oh-my-winuxsh.winux"

if [ -z "${WINUXSH:-}" ]; then
  if [ -n "${BASH_SOURCE:-}" ]; then
    __omw_entry="${BASH_SOURCE[0]}"
    WINUXSH="$(cd "$(dirname "$__omw_entry")" 2>/dev/null && pwd)"
  else
    WINUXSH="$HOME/.oh-my-winuxsh"
  fi
  export WINUXSH
fi

: "${WINUXSH_CUSTOM:=$HOME/.winuxsh/custom}"
if [ -z "${WINUXSH_THEME+x}" ]; then
  WINUXSH_THEME=minimal
fi
if [ -z "${WINUXSH_THEME_PLUGIN+x}" ] && [ -n "${WINUXSH_THEME:-}" ]; then
  WINUXSH_THEME_PLUGIN="theme-$WINUXSH_THEME"
fi

if [ -z "${WINUXSH_DISABLE_DEFAULT_PLUGINS:-}" ]; then
  if [ "${#WINUXSH_PLUGINS[@]}" -eq 0 ] 2>/dev/null; then
    WINUXSH_PLUGINS=(prompt-core git)
  fi
fi

[ -f "$WINUXSH/lib/hooks.winux" ] && . "$WINUXSH/lib/hooks.winux"
[ -f "$WINUXSH/lib/aliases.winux" ] && . "$WINUXSH/lib/aliases.winux"
[ -f "$WINUXSH/lib/prompt.winux" ] && . "$WINUXSH/lib/prompt.winux"
[ -f "$WINUXSH/lib/git.winux" ] && . "$WINUXSH/lib/git.winux"

__omw_loaded_plugins=" "

for __omw_plugin in "${WINUXSH_PLUGINS[@]}"; do
  if [ -n "$__omw_plugin" ]; then
    __omw_plugin_custom="$WINUXSH_CUSTOM/plugins/$__omw_plugin/$__omw_plugin.plugin.winux"
    __omw_plugin_bundle="$WINUXSH/plugins/$__omw_plugin/$__omw_plugin.plugin.winux"

    if [ -f "$__omw_plugin_custom" ]; then
      . "$__omw_plugin_custom"
    else
      if [ -f "$__omw_plugin_bundle" ]; then
        . "$__omw_plugin_bundle"
      fi
    fi
    __omw_loaded_plugins="$__omw_loaded_plugins$__omw_plugin "
  fi
done

if [ -n "${WINUXSH_THEME:-}" ] && [ -n "${WINUXSH_THEME_PLUGIN:-}" ]; then
  case "$__omw_loaded_plugins" in
    *" $WINUXSH_THEME_PLUGIN "*) ;;
    *)
      __omw_theme_plugin_custom="$WINUXSH_CUSTOM/plugins/$WINUXSH_THEME_PLUGIN/$WINUXSH_THEME_PLUGIN.plugin.winux"
      __omw_theme_plugin_bundle="$WINUXSH/plugins/$WINUXSH_THEME_PLUGIN/$WINUXSH_THEME_PLUGIN.plugin.winux"

      if [ -f "$__omw_theme_plugin_custom" ]; then
        . "$__omw_theme_plugin_custom"
      else
        if [ -f "$__omw_theme_plugin_bundle" ]; then
          . "$__omw_theme_plugin_bundle"
        else
          echo "oh-my-winuxsh: theme plugin '$WINUXSH_THEME_PLUGIN' not found for theme '$WINUXSH_THEME'" >&2
        fi
      fi
      ;;
  esac
fi

winuxsh_run_startup_hooks 2>/dev/null || true

unset __omw_lib __omw_plugin __omw_plugin_custom __omw_plugin_bundle __omw_entry __omw_theme_plugin_custom __omw_theme_plugin_bundle __omw_loaded_plugins
