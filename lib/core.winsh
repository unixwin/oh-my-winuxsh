# Core utilities for Oh My Winuxsh
# Provides helper functions and common utilities

# --- Color Definitions ---
WINUXSH_COLOR_BLACK='%F{black}'
WINUXSH_COLOR_RED='%F{red}'
WINUXSH_COLOR_GREEN='%F{green}'
WINUXSH_COLOR_YELLOW='%F{yellow}'
WINUXSH_COLOR_BLUE='%F{blue}'
WINUXSH_COLOR_MAGENTA='%F{magenta}'
WINUXSH_COLOR_CYAN='%F{cyan}'
WINUXSH_COLOR_WHITE='%F{white}'
WINUXSH_COLOR_ORANGE='%F{208}'
WINUXSH_COLOR_PURPLE='%F{129}'
WINUXSH_COLOR_PINK='%F{199}'
WINUXSH_COLOR_TEAL='%F{43}'
WINUXSH_COLOR_GOLD='%F{220}'
WINUXSH_COLOR_SILVER='%F{250}'
WINUXSH_COLOR_RESET='%f%b%u'

# Bold variants
WINUXSH_COLOR_BOLD_BLACK='%B%F{black}'
WINUXSH_COLOR_BOLD_RED='%B%F{red}'
WINUXSH_COLOR_BOLD_GREEN='%B%F{green}'
WINUXSH_COLOR_BOLD_YELLOW='%B%F{yellow}'
WINUXSH_COLOR_BOLD_BLUE='%B%F{blue}'
WINUXSH_COLOR_BOLD_MAGENTA='%B%F{magenta}'
WINUXSH_COLOR_BOLD_CYAN='%B%F{cyan}'
WINUXSH_COLOR_BOLD_WHITE='%B%F{white}'

# --- Unicode Symbols ---
WINUXSH_SYMBOL_HOME='🏠'
WINUXSH_SYMBOL_FOLDER='📁'
WINUXSH_SYMBOL_FILE='📄'
WINUXSH_SYMBOL_GIT='🌿'
WINUXSH_SYMBOL_LOCK='🔒'
WINUXSH_SYMBOL_KEY='🔑'
WINUXSH_SYMBOL_STAR='⭐'
WINUXSH_SYMBOL_ROCKET='🚀'
WINUXSH_SYMBOL_FIRE='🔥'
WINUXSH_SYMBOL_BOLT='⚡'
WINUXSH_SYMBOL_CHECK='✅'
WINUXSH_SYMBOL_CROSS='❌'
WINUXSH_SYMBOL_WARN='⚠️'
WINUXSH_SYMBOL_INFO='ℹ️'
WINUXSH_SYMBOL_ARROW='➜'
WINUXSH_SYMBOL_RARROW='→'
WINUXSH_SYMBOL_LARROW='←'
WINUXSH_SYMBOL_DIAMOND='◆'
WINUXSH_SYMBOL_DOT='●'
WINUXSH_SYMBOL_LAMBDA='λ'
WINUXSH_SYMBOL_POWER='⏻'
WINUXSH_SYMBOL_AT='@'
WINUXSH_SYMBOL_HASH='#'
WINUXSH_SYMBOL_DOLLAR='$'
WINUXSH_SYMBOL_TILDE='~'

# ASCII fallback symbols (when Unicode is not available)
WINUXSH_ASCII_ARROW='->'
WINUXSH_ASCII_STAR='*'
WINUXSH_ASCII_LAMBDA='\'
WINUXSH_ASCII_DOT='.'

# --- Helper Functions ---

# Check if we're in a git repo
function winuxsh_is_git() {
    git rev-parse --git-dir > /dev/null 2>&1
}

# Get the current git branch
function winuxsh_git_branch() {
    git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null
}

# Get git status info
function winuxsh_git_status() {
    local ahead=0
    local behind=0
    local staged=0
    local unstaged=0
    local untracked=0
    local conflicted=0

    # Get ahead/behind counts
    local remote_status=$(git status -sb 2>/dev/null | head -1)
    if echo "$remote_status" | grep -q '\[ahead'; then
        ahead=$(echo "$remote_status" | sed 's/.*ahead \([0-9]*\).*/\1/')
    fi
    if echo "$remote_status" | grep -q '\[behind'; then
        behind=$(echo "$remote_status" | sed 's/.*behind \([0-9]*\).*/\1/')
    fi

    # Get working tree status
    while IFS= read -r line; do
        case "$line" in
            '?? '*) ((untracked++)) ;;
            ' M '*|'M '*|'A '*|'D '*|'R '*) ((staged++)) ;;
            'MM '*|'AM '*|'AD '*) ((staged++)); ((unstaged++)) ;;
            'UU '*|'AA '*|'DD '*) ((conflicted++)) ;;
            '?? '*) ((untracked++)) ;;
            *' M '*|*' D '*|*' A '*) ((unstaged++)) ;;
        esac
    done < <(git status --porcelain 2>/dev/null)

    local result=""
    [ $ahead -gt 0 ] && result="${result}↑${ahead}"
    [ $behind -gt 0 ] && result="${result}↓${behind}"
    [ $staged -gt 0 ] && result="${result}✔${staged}"
    [ $unstaged -gt 0 ] && result="${result}✎${unstaged}"
    [ $untracked -gt 0 ] && result="${result}+${untracked}"
    [ $conflicted -gt 0 ] && result="${result}✘${conflicted}"

    echo "$result"
}

# Get current node version (if nvm or node is available)
function winuxsh_node_version() {
    if command -v node > /dev/null 2>&1; then
        echo "⬢ $(node --version 2>/dev/null | sed 's/v//')"
    fi
}

# Get current Python virtual environment name
function winuxsh_python_venv() {
    if [ -n "$VIRTUAL_ENV" ]; then
        echo "${WINUXSH_SYMBOL_STAR} $(basename "$VIRTUAL_ENV")"
    fi
}
