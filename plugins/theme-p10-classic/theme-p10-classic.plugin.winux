# Powerlevel-style classic official theme plugin.

[ -f "$WINUXSH/lib/prompt.winux" ] && . "$WINUXSH/lib/prompt.winux"

WINUXSH_ACTIVE_THEME=p10-classic
WINUXSH_THEME_FILE="$WINUXSH/themes/p10-classic.toml"
WINUXSH_PROMPT_SYMBOL="${WINUXSH_PROMPT_SYMBOL:-❯}"
WINUXSH_THEME_GIT_PROMPT_PREFIX="${WINUXSH_THEME_GIT_PROMPT_PREFIX:-}"
WINUXSH_THEME_GIT_PROMPT_SUFFIX="${WINUXSH_THEME_GIT_PROMPT_SUFFIX:-}"
WINUXSH_THEME_GIT_PROMPT_DIRTY="${WINUXSH_THEME_GIT_PROMPT_DIRTY:- *}"
WINUXSH_THEME_GIT_PROMPT_CLEAN="${WINUXSH_THEME_GIT_PROMPT_CLEAN:-}"
export WINUXSH_ACTIVE_THEME WINUXSH_THEME_FILE WINUXSH_PROMPT_SYMBOL
export WINUXSH_THEME_GIT_PROMPT_PREFIX WINUXSH_THEME_GIT_PROMPT_SUFFIX
export WINUXSH_THEME_GIT_PROMPT_DIRTY WINUXSH_THEME_GIT_PROMPT_CLEAN

winuxsh_prompt_use_template "{cwd} {git}{newline}{prompt_char} " "{status}{command_execution_time}{time} "
