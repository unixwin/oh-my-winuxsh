# Oh My Winuxsh dotenv plugin.

[ -f "$WINUXSH/lib/hooks.winux" ] && . "$WINUXSH/lib/hooks.winux"

__winuxsh_dotenv_load() {
  [ -f .env ] || return 0

  while IFS= read -r __winuxsh_dotenv_line || [ -n "$__winuxsh_dotenv_line" ]; do
    case "$__winuxsh_dotenv_line" in
      ""|\#*)
        continue
        ;;
      export\ *)
        __winuxsh_dotenv_line=${__winuxsh_dotenv_line#export }
        ;;
    esac

    case "$__winuxsh_dotenv_line" in
      *=*) ;;
      *) continue ;;
    esac

    __winuxsh_dotenv_key=${__winuxsh_dotenv_line%%=*}
    __winuxsh_dotenv_value=${__winuxsh_dotenv_line#*=}

    case "$__winuxsh_dotenv_key" in
      ""|[0-9]*|*[!A-Za-z0-9_]*)
        continue
        ;;
    esac

    case "$__winuxsh_dotenv_value" in
      \"*\")
        __winuxsh_dotenv_value=${__winuxsh_dotenv_value#\"}
        __winuxsh_dotenv_value=${__winuxsh_dotenv_value%\"}
        ;;
      \'*\')
        __winuxsh_dotenv_value=${__winuxsh_dotenv_value#\'}
        __winuxsh_dotenv_value=${__winuxsh_dotenv_value%\'}
        ;;
    esac

    export "$__winuxsh_dotenv_key=$__winuxsh_dotenv_value"
  done < .env
}

winuxsh_add_startup_hook __winuxsh_dotenv_load
winuxsh_add_precmd_hook __winuxsh_dotenv_load
winuxsh_add_chpwd_hook __winuxsh_dotenv_load
