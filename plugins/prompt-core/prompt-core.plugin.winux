# Official prompt core plugin.
#
# This is the public prompt/plugin API layer. Git status is consumed as a
# host-provided snapshot so prompt rendering never runs git or repaints the
# active input line after a late async result.

[ -f "$WINUXSH/lib/prompt.winux" ] && . "$WINUXSH/lib/prompt.winux"

: "${WINUXSH_PROMPT_GIT_BACKEND:=native}"
: "${WINUXSH_PROMPT_LEFT:={cwd} {git}{prompt_char} }"
: "${WINUXSH_PROMPT_RIGHT:=}"
: "${WINUXSH_PROMPT_GIT_DIRTY:=0}"

case "${WINUXSH_PROMPT_GIT_BACKEND:-native}" in
  legacy|shell)
    [ -f "$WINUXSH/lib/git.winux" ] && . "$WINUXSH/lib/git.winux"
    ;;
esac

winuxsh_prompt_register_segment() {
  __omw_segment_name="$1"
  __omw_segment_function="$2"

  [ -n "$__omw_segment_name" ] || return 1
  [ -n "$__omw_segment_function" ] || return 1
  case "$__omw_segment_name" in
    *[!A-Za-z0-9_]*)
      return 1
      ;;
  esac

  eval "WINUXSH_PROMPT_SEGMENT_$__omw_segment_name=\"$__omw_segment_function\""
  case " ${WINUXSH_PROMPT_SEGMENTS:-} " in
    *" $__omw_segment_name "*) ;;
    *)
      WINUXSH_PROMPT_SEGMENTS="${WINUXSH_PROMPT_SEGMENTS:+$WINUXSH_PROMPT_SEGMENTS }$__omw_segment_name"
      export WINUXSH_PROMPT_SEGMENTS
      ;;
  esac
}

winuxsh_prompt_segment_value() {
  __omw_segment_name="$1"
  case "$__omw_segment_name" in
    ""|*[!A-Za-z0-9_]*)
      return 1
      ;;
  esac

  eval "__omw_segment_function=\${WINUXSH_PROMPT_SEGMENT_$__omw_segment_name:-}"
  [ -n "$__omw_segment_function" ] || return 1
  "$__omw_segment_function"
}

winuxsh_prompt_cwd() {
  printf "%s" "$PWD"
}

winuxsh_prompt_cwd_base() {
  __omw_cwd_base="${PWD##*/}"
  [ -n "$__omw_cwd_base" ] || __omw_cwd_base="$PWD"
  printf "%s" "$__omw_cwd_base"
}

winuxsh_prompt_user_host() {
  __omw_user="${USER:-${USERNAME:-}}"
  __omw_host="${HOSTNAME:-${COMPUTERNAME:-}}"
  if [ -n "$__omw_user" ] && [ -n "$__omw_host" ]; then
    printf "%s@%s" "$__omw_user" "$__omw_host"
  else
    printf "%s%s" "$__omw_user" "$__omw_host"
  fi
}

winuxsh_prompt_git_info() {
  case "${WINUXSH_PROMPT_GIT_BACKEND:-native}" in
    native|snapshot)
      printf "%s" "${WINUXSH_PROMPT_GIT:-}"
      ;;
    legacy|shell)
      git_prompt_info
      ;;
    *)
      printf "%s" "${WINUXSH_PROMPT_GIT:-}"
      ;;
  esac
}

winuxsh_prompt_refresh_git_snapshot() {
  case "${WINUXSH_PROMPT_GIT_BACKEND:-native}" in
    legacy|shell)
      WINUXSH_PROMPT_GIT="$(git_prompt_info)" || WINUXSH_PROMPT_GIT=""
      export WINUXSH_PROMPT_GIT
      ;;
  esac
  WINUXSH_PROMPT_GIT_DIRTY=0
  export WINUXSH_PROMPT_GIT_DIRTY
}

winuxsh_prompt_mark_git_snapshot_dirty() {
  WINUXSH_PROMPT_GIT_DIRTY=1
  export WINUXSH_PROMPT_GIT_DIRTY
}

winuxsh_prompt_preexec() {
  case "${WINUXSH_PREEXEC_COMMAND:-}" in
    git|git\ *|*/git|*/git\ *|git.exe|git.exe\ *|*/git.exe|*/git.exe\ *)
      winuxsh_prompt_mark_git_snapshot_dirty
      ;;
  esac
}

winuxsh_prompt_precmd() {
  if [ "${WINUXSH_PROMPT_GIT_DIRTY:-0}" != "0" ]; then
    winuxsh_prompt_refresh_git_snapshot
  fi
}

winuxsh_prompt_status() {
  __omw_status="${WINUXSH_LAST_STATUS:-0}"
  if [ "$__omw_status" != "0" ] && [ -n "$__omw_status" ]; then
    printf "status:%s " "$__omw_status"
  fi
}

winuxsh_prompt_time() {
  date "+%H:%M" 2>/dev/null || true
}

winuxsh_prompt_command_execution_time() {
  [ -n "${WINUXSH_LAST_COMMAND_DURATION:-}" ] && printf "%s" "$WINUXSH_LAST_COMMAND_DURATION"
}

winuxsh_prompt_char() {
  printf "%s" "${WINUXSH_PROMPT_SYMBOL:-%}"
}

winuxsh_prompt_render_template() {
  __omw_template="$1"
  __omw_newline="
"

  for __omw_segment_name in ${WINUXSH_PROMPT_SEGMENTS:-}; do
    case "$__omw_template" in
      *"{$__omw_segment_name}"*)
        if [ "$__omw_segment_name" = "newline" ]; then
          __omw_segment_value="$__omw_newline"
        else
          __omw_segment_value="$(winuxsh_prompt_segment_value "$__omw_segment_name")" || __omw_segment_value=""
        fi
        __omw_template="${__omw_template//\{$__omw_segment_name\}/$__omw_segment_value}"
        ;;
    esac
  done

  # Compatibility tokens for early theme plugins and host TOML examples.
  case "$__omw_template" in
    *"{git_prompt}"*)
      __omw_git_prompt_compat="$(winuxsh_prompt_git_info)" || __omw_git_prompt_compat=""
      __omw_template="${__omw_template//\{git_prompt\}/$__omw_git_prompt_compat}"
      ;;
  esac
  case "$__omw_template" in
    *"{symbol}"*)
      __omw_symbol_compat="${WINUXSH_PROMPT_SYMBOL:-%}"
      __omw_template="${__omw_template//\{symbol\}/$__omw_symbol_compat}"
      ;;
  esac
  case "$__omw_template" in
    *"{cwd_base}"*)
      __omw_cwd_base_compat="$(winuxsh_prompt_cwd_base)" || __omw_cwd_base_compat=""
      __omw_template="${__omw_template//\{cwd_base\}/$__omw_cwd_base_compat}"
      ;;
  esac
  printf "%s" "$__omw_template"
}

winuxsh_prompt_render_left() {
  winuxsh_prompt_render_template "$WINUXSH_PROMPT_LEFT"
}

winuxsh_prompt_render_right() {
  winuxsh_prompt_render_template "$WINUXSH_PROMPT_RIGHT"
}

winuxsh_prompt_register_segment cwd winuxsh_prompt_cwd
winuxsh_prompt_register_segment cwd_base winuxsh_prompt_cwd_base
winuxsh_prompt_register_segment user_host winuxsh_prompt_user_host
winuxsh_prompt_register_segment git winuxsh_prompt_git_info
winuxsh_prompt_register_segment status winuxsh_prompt_status
winuxsh_prompt_register_segment time winuxsh_prompt_time
winuxsh_prompt_register_segment command_execution_time winuxsh_prompt_command_execution_time
winuxsh_prompt_register_segment prompt_char winuxsh_prompt_char
winuxsh_prompt_register_segment newline winuxsh_prompt_char

winuxsh_prompt_refresh_git_snapshot

winuxsh_add_preexec_hook winuxsh_prompt_preexec
winuxsh_add_chpwd_hook winuxsh_prompt_mark_git_snapshot_dirty
winuxsh_add_precmd_hook winuxsh_prompt_precmd
