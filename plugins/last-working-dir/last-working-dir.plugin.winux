# Oh My Winuxsh last-working-dir plugin.

[ -f "$WINUXSH/lib/hooks.winux" ] && . "$WINUXSH/lib/hooks.winux"

__winuxsh_lwd_cache_dir=${WINUXSH_CACHE_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/winuxsh}
__winuxsh_lwd_cache_file=${WINUXSH_LAST_WORKING_DIR_FILE:-$__winuxsh_lwd_cache_dir/last-working-dir}

__winuxsh_lwd_restore() {
  [ -f "$__winuxsh_lwd_cache_file" ] || return 0
  IFS= read -r __winuxsh_lwd_target < "$__winuxsh_lwd_cache_file" || return 0
  [ -n "$__winuxsh_lwd_target" ] && [ -d "$__winuxsh_lwd_target" ] && cd "$__winuxsh_lwd_target"
}

__winuxsh_lwd_save() {
  mkdir -p "$__winuxsh_lwd_cache_dir" 2>/dev/null || return 0
  printf '%s\n' "$PWD" > "$__winuxsh_lwd_cache_file"
}

lwd() {
  if [ -f "$__winuxsh_lwd_cache_file" ]; then
    cat "$__winuxsh_lwd_cache_file"
  fi
}

winuxsh_add_startup_hook __winuxsh_lwd_restore
winuxsh_add_chpwd_hook __winuxsh_lwd_save
