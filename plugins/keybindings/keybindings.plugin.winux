# Keybindings bridge plugin.
#
# Reedline still owns the low-level keybinding application. This plugin makes
# the official keybinding presets visible as plugin-owned assets during the
# migration away from host-owned builtin packs.

WINUXSH_KEYBINDINGS_PLUGIN=keybindings
WINUXSH_KEYBINDING_ASSETS="$WINUXSH/keybindings/common.toml $WINUXSH/keybindings/emacs.toml $WINUXSH/keybindings/vi.toml"
export WINUXSH_KEYBINDINGS_PLUGIN WINUXSH_KEYBINDING_ASSETS
