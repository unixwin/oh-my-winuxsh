# Powerlevel-style lean official theme plugin.

[ -f "$WINUXSH/lib/prompt.winux" ] && . "$WINUXSH/lib/prompt.winux"

WINUXSH_ACTIVE_THEME=p10-lean
WINUXSH_THEME_FILE="$WINUXSH/themes/p10-lean.toml"
WINUXSH_PROMPT_SYMBOL="${WINUXSH_PROMPT_SYMBOL:-❯}"
export WINUXSH_ACTIVE_THEME WINUXSH_THEME_FILE WINUXSH_PROMPT_SYMBOL

winuxsh_prompt_use_template "{cwd} {git}{newline}{prompt_char} " ""
