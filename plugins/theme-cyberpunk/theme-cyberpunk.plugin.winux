# Cyberpunk official theme plugin.

[ -f "$WINUXSH/lib/prompt.winux" ] && . "$WINUXSH/lib/prompt.winux"

WINUXSH_ACTIVE_THEME=cyberpunk
WINUXSH_THEME_FILE="$WINUXSH/themes/cyberpunk.toml"
WINUXSH_PROMPT_SYMBOL="${WINUXSH_PROMPT_SYMBOL:-%}"
export WINUXSH_ACTIVE_THEME WINUXSH_THEME_FILE WINUXSH_PROMPT_SYMBOL

winuxsh_prompt_use_template "{user_host}::{cwd_base} {git}{prompt_char} " ""
