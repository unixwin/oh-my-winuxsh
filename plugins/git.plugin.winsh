# Git Plugin for Oh My Winuxsh
# Provides git aliases, enhanced prompt, and helper functions

# --- Git Aliases ---
alias g='git'
alias ga='git add'
alias gaa='git add --all'
alias gap='git add -p'
alias gb='git branch'
alias gbl='git blame -b -w'
alias gc='git commit -v'
alias gc!='git commit -v --amend'
alias gca='git commit -v -a'
alias gca!='git commit -v -a --amend'
alias gcm='git commit -m'
alias gco='git checkout'
alias gcp='git cherry-pick'
alias gd='git diff'
alias gdc='git diff --cached'
alias gf='git fetch'
alias gfa='git fetch --all --prune'
alias gl='git pull'
alias glg='git log --stat'
alias glgp='git log --stat -p'
alias glo='git log --oneline --decorate'
alias glog='git log --oneline --decorate --graph'
alias gloga='git log --oneline --decorate --graph --all'
alias gm='git merge'
alias gp='git push'
alias gpo='git push origin'
alias gr='git remote'
alias gra='git remote add'
alias grb='git rebase'
alias grbi='git rebase --interactive'
alias grev='git revert'
alias grh='git reset'
alias grh!='git reset --hard'
alias grm='git rm'
alias grmc='git rm --cached'
alias grs='git restore'
alias grss='git restore --source'
alias grst='git restore --staged'
alias gst='git status'
alias gsta='git stash push'
alias gstaa='git stash apply'
alias gstc='git stash clear'
alias gstd='git stash drop'
alias gstl='git stash list'
alias gstp='git stash pop'
alias gsts='git stash show --text'
alias gsu='git submodule update'
alias gsw='git switch'
alias gswc='git switch -c'
alias gunwip='git log -n 1 | grep -q -c "\-\-wip\-\-" && git reset HEAD~1'
alias gwip='git add -A; git rm $(git ls-files --deleted) 2> /dev/null; git commit -m "--wip--"'

# --- Git prompt info (for use in themes) ---
function winuxsh_git_prompt_info() {
    if winuxsh_is_git; then
        local branch=$(winuxsh_git_branch)
        local status=$(winuxsh_git_status)
        local result="${WINUXSH_COLOR_BOLD_GREEN}${WINUXSH_SYMBOL_GIT} ${branch}"
        [ -n "$status" ] && result="${result} ${WINUXSH_COLOR_BOLD_YELLOW}${status}"
        echo "${result}${WINUXSH_COLOR_RESET}"
    fi
}
