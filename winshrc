# Oh My Winuxsh!
#
# A framework for managing your WinSH shell configuration.
# Includes themes, plugins, and prompt customization.
#
# Repository: https://github.com/caomengxuan666/oh-my-winuxsh
# License: MIT

# --- Core Setup ---
export WINUXSH="$HOME/.oh-my-winuxsh"

# Load core library
if [ -f "$WINUXSH/lib/core.winsh" ]; then
    source "$WINUXSH/lib/core.winsh"
fi

# Load theme
if [ -z "$WINUXSH_THEME" ]; then
    WINUXSH_THEME="default"
fi

if [ -f "$WINUXSH/themes/${WINUXSH_THEME}.theme.winsh" ]; then
    source "$WINUXSH/themes/${WINUXSH_THEME}.theme.winsh"
fi

# Load plugins
plugins=(
    git
    completion
)

for plugin in "${plugins[@]}"; do
    if [ -f "$WINUXSH/plugins/${plugin}.plugin.winsh" ]; then
        source "$WINUXSH/plugins/${plugin}.plugin.winsh"
    fi
done

# --- Welcome Message ---
echo "Oh My Winuxsh! v1.0.0"
echo "  Theme:  $WINUXSH_THEME"
echo "  Plugins: ${plugins[*]}"
echo ""
