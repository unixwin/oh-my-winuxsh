# Oh My Winuxsh!
# Simplified config for WinSH loader

# Core setup
WINUXSH="$HOME/.oh-my-winuxsh"
WINUXSH_THEME="default"

# Load core library (colors, symbols, helpers)
source "$HOME/.oh-my-winuxsh/lib/core.winsh"

# Load theme
source "$HOME/.oh-my-winuxsh/themes/$WINUXSH_THEME.theme.winsh"

# Load plugins
source "$HOME/.oh-my-winuxsh/plugins/git.plugin.winsh"
source "$HOME/.oh-my-winuxsh/plugins/completion.plugin.winsh"
