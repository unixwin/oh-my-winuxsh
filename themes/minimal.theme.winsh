# Minimal Theme - Simple and Clean
# For those who prefer minimal aesthetics

SYMBOL_PROMPT="λ"

PROMPT="${WINUXSH_COLOR_BOLD_WHITE}%~${WINUXSH_COLOR_RESET} \$(winuxsh_minimal_git) ${SYMBOL_PROMPT} "

RPROMPT=""

function winuxsh_minimal_git() {
    if winuxsh_is_git; then
        local branch=$(winuxsh_git_branch)
        local status=$(winuxsh_git_status)
        local dirty=""
        [ -n "$status" ] && dirty="${WINUXSH_COLOR_RED}●${WINUXSH_COLOR_RESET}"
        echo "${WINUXSH_COLOR_BOLD_GREEN}${branch}${dirty}"
    fi
}
