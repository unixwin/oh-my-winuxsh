# Ocean Theme - Calm Blues and Greens
# A relaxing theme inspired by the deep ocean

SYMBOL_WAVE="🌊"
SYMBOL_SHELL="🐚"
SYMBOL_FISH="🐠"
SYMBOL_PROMPT="❯"

PROMPT="${WINUXSH_COLOR_BOLD_BLUE}┌─ ${SYMBOL_SHELL}  ${WINUXSH_COLOR_CYAN}%~${WINUXSH_COLOR_RESET} \$(winuxsh_ocean_git)
${WINUXSH_COLOR_BOLD_BLUE}└${WINUXSH_COLOR_BOLD_TEAL}${SYMBOL_PROMPT}${WINUXSH_COLOR_RESET} "

RPROMPT="${WINUXSH_COLOR_BOLD_BLUE}%n@%m${WINUXSH_COLOR_RESET} ${WINUXSH_COLOR_TEAL}%T${WINUXSH_COLOR_RESET}"

function winuxsh_ocean_git() {
    if winuxsh_is_git; then
        local branch=$(winuxsh_git_branch)
        echo "${WINUXSH_COLOR_GREEN}${SYMBOL_WAVE} ${branch}${WINUXSH_COLOR_RESET}"
    fi
}
